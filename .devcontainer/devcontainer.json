{
  "name": "Nexus Folha Lab (isolated)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Folha — simulação sem autoridade",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-folha.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
