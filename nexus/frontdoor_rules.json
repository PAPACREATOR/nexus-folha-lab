{
  "version": "1.0",
  "max_text_chars": 100000,
  "prefixes": [
    [
      "@@",
      "arquivo"
    ],
    [
      "\"\"",
      "fontes"
    ],
    [
      "??",
      "perguntar"
    ],
    [
      "&",
      "trabalhar"
    ],
    [
      "%",
      "calcular"
    ],
    [
      "#",
      "tema"
    ],
    [
      "@",
      "web"
    ]
  ],
  "natural_rules": {
    "arquivo": [
      "\\bguarda(?:r)?\\b",
      "\\barquiva(?:r)?\\b",
      "\\bsalva(?:r)?\\b",
      "\\bguarda isto\\b"
    ],
    "web": [
      "\\bpesquis[ae](?:r)?\\b.*\\b(?:web|internet|online|net)\\b",
      "\\bprocura(?:r)?\\b.*\\b(?:web|internet|online|net)\\b",
      "\\bpesquiza(?:r)?\\b.*\\b(?:web|internet|online|net)\\b"
    ],
    "fontes": [
      "\\b(?:encontra|procura|pesquisa|pesquiza)\\b.*\\bfontes?\\b",
      "\\bquais\\b.*\\bfontes?\\b",
      "\\bda(?:-me)?\\b.*\\bfontes?\\b",
      "\\bdá(?:-me)?\\b.*\\bfontes?\\b"
    ],
    "trabalhar": [
      "\\btrabalha(?:r)?\\b",
      "\\b(?:reve|revê|rever)\\b",
      "\\bmelhora(?:r)?\\b",
      "\\breescreve(?:r)?\\b",
      "\\bcorrige(?:r)?\\b"
    ],
    "perguntar": [
      "\\bexplica(?:r)?\\b",
      "\\bresponde(?:r)?\\b",
      "\\bo que (?:e|é)\\b",
      "\\bquem (?:e|é)\\b",
      "\\bporqu[eê]\\b",
      "\\bcomo\\b"
    ],
    "calcular": [
      "\\bcalcula(?:r)?\\b",
      "\\bfaz(?:er)?\\b.*\\bconta\\b",
      "\\bquanto (?:e|é)\\b",
      "\\bsoma(?:r)?\\b"
    ],
    "tema": [
      "(?:^|\\be também\\s+)(?:tema|assunto)\\b",
      "(?:^|\\be também\\s+)quero falar sobre\\b"
    ]
  }
}
